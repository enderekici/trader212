# syntax=docker/dockerfile:1
# check=skip=FromPlatformFlagConstDisallowed

# Build stage: always runs on amd64 (fast, native — no QEMU).
# Next.js standalone output is pure JS, so it's architecture-independent.
FROM --platform=linux/amd64 node:24-alpine AS builder
WORKDIR /app
COPY web/package*.json ./
RUN npm ci
COPY web/ .
# Persist Next.js build cache across CI runs via BuildKit cache mount
RUN --mount=type=cache,target=/app/.next/cache npm run build

# Runtime stage: uses the target platform's base image (amd64 or arm64).
# Only copies JS files — no native compilation needed.
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/').then(r => { if (!r.ok) process.exit(1) }).catch(() => process.exit(1))"
CMD ["node", "server.js"]
